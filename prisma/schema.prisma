generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int         @id @default(autoincrement())
  firstName   String
  lastName    String
  age         Int?
  email       String      @unique
  password    String
  avatar      String?
  acceptTerms Boolean     @default(false)
  isOnline    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  messages    Messages[]  @relation("MessagesToUsers")
  roomUsers   RoomUsers[] @relation("RoomUsersToUsers")
}

model RoomUsers {
  id     Int   @id @default(autoincrement())
  roomId Int
  userId Int
  room   Rooms @relation("RoomUsersToRooms", fields: [roomId], references: [id])
  user   Users @relation("RoomUsersToUsers", fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
}

model Rooms {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  messages  Messages[]  @relation("MessagesToRooms")
  roomUsers RoomUsers[] @relation("RoomUsersToRooms")
}

model Messages {
  id        Int      @id @default(autoincrement())
  text      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int
  roomId    Int
  room      Rooms    @relation("MessagesToRooms", fields: [roomId], references: [id])
  user      Users    @relation("MessagesToUsers", fields: [userId], references: [id])
}

model Terms {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(100)
  text      String
  createdAt DateTime @default(now())
}
